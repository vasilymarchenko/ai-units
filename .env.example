# Machine-local values the vault connector plugins expand.
# This file is documentation only — Claude Code does not read it.
# Set these in ~/.claude/settings.json under "env", or as user environment
# variables. Never commit real values.
#
# One variable per vault: VAM_VAULT_<SLUG> feeds the vam-vault-<slug> connector,
# which mounts it as the obsidian-<slug> MCP server. Set only the vaults this
# machine actually has, and install only those connectors.

VAM_VAULT_KB=D:\Notes\MyVault
